{
  "name": "securelink",
  "version": "1.0.0",
  "description": "Pair two devices on the same Wi-Fi and send files end-to-end encrypted (IT 021 Usable Security, Group 4).",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "start:http": "node server/index.js --http",
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i src/input.css -o public/tailwind.output.css --minify",
    "build:js": "esbuild src/main.jsx --bundle --minify --format=iife --target=es2020,safari15 --define:process.env.NODE_ENV=\\\"production\\\" --outfile=public/app.bundle.js",
    "test": "node --test test/server.test.mjs test/e2e.test.mjs",
    "demo:tamper": "node server/index.js --demo-tamper",
    "demo:mitm": "node tools/mitm-relay.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.45.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "selfsigned": "2.4.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.14"
  },
  "engines": {
    "node": ">=18.17"
  }
}
